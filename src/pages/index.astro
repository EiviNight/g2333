---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config';
---

<BaseLayout description={SITE.description}>
  <section class="wrap hero">
    <p class="eyebrow">Anime &amp; Doujin Club</p>
    <h1>{SITE.name}</h1>
    <p class="lede hero-lede">{SITE.description}</p>
    <div class="hero-actions">
      <a class="btn btn-primary" href="/join/">加入我们</a>
      <a class="btn btn-ghost" href="/activities/">看看活动</a>
    </div>
    <ul class="hero-stats">
      <li><strong>3</strong><span>每周固定活动</span></li>
      <li><strong>2</strong><span>每年社刊期数</span></li>
      <li><strong>0</strong><span>加入门槛</span></li>
    </ul>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>社团活动</h2>
      <a class="more" href="/activities/">全部活动 →</a>
    </div>
    <p id="act-status" class="status muted" hidden></p>
    <p id="act-empty" class="muted" hidden>还没有活动记录，去后台发布第一条吧。</p>
    <div id="act-list" class="grid grid-3" hidden></div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>文章</h2>
      <a class="more" href="/blog/">全部文章 →</a>
    </div>
    <p id="post-status" class="status muted" hidden></p>
    <p id="post-empty" class="muted" hidden>还没有文章。</p>
    <div id="post-list" class="grid grid-3" hidden></div>
  </section>

  <section class="wrap section">
    <div class="section-head">
      <h2>作品展示</h2>
      <a class="more" href="/gallery/">全部作品 →</a>
    </div>
    <p id="img-status" class="status muted" hidden></p>
    <p id="img-empty" class="muted" hidden>作品区还空着。</p>
    <div id="img-list" class="gallery" hidden></div>
  </section>

  <section class="wrap section">
    <div class="card cta">
      <div>
        <h2>想加入？</h2>
        <p class="muted">{SITE.recruit}</p>
      </div>
      <a class="btn btn-primary" href="/join/">填写报名表</a>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    api,
    renderContentList,
    renderImageGrid,
    setListState,
    type ContentItem,
    type ImageItem,
  } from '../lib/client';

  const LIMIT = { activities: 3, posts: 3, images: 8 };

  async function loadContent(
    kind: 'activities' | 'posts',
    listId: string,
    statusId: string,
    emptyId: string,
  ) {
    const list = document.getElementById(listId);
    const status = document.getElementById(statusId);
    const empty = document.getElementById(emptyId);
    if (!list || !empty) return;

    setListState(status, '加载中…', 'pending');
    try {
      const { res, data } = await api<{ ok: boolean; items: ContentItem[]; error?: string }>(
        `/api/${kind}`,
      );
      if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);
      if (status) status.hidden = true;
      if (data.items.length === 0) {
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      renderContentList(list, data.items.slice(0, LIMIT[kind]), `/${kind}/detail/`);
    } catch (err) {
      setListState(status, '内容暂时读不出来，稍后刷新试试。', 'err');
      console.error(err);
    }
  }

  async function loadImages() {
    const list = document.getElementById('img-list');
    const status = document.getElementById('img-status');
    const empty = document.getElementById('img-empty');
    if (!list || !empty) return;

    setListState(status, '加载中…', 'pending');
    try {
      const { res, data } = await api<{ ok: boolean; items: ImageItem[]; error?: string }>(
        '/api/images',
      );
      if (!res.ok || !data.ok) throw new Error(data.error || `HTTP ${res.status}`);
      if (status) status.hidden = true;
      if (data.items.length === 0) {
        empty.hidden = false;
        return;
      }
      empty.hidden = true;
      renderImageGrid(list, data.items.slice(0, LIMIT.images));
    } catch (err) {
      setListState(status, '作品暂时读不出来。', 'err');
      console.error(err);
    }
  }

  loadContent('activities', 'act-list', 'act-status', 'act-empty');
  loadContent('posts', 'post-list', 'post-status', 'post-empty');
  loadImages();
</script>

<style>
  .hero {
    padding: 64px 20px 40px;
  }

  .hero-lede {
    margin-bottom: 26px;
  }

  .hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 40px;
  }

  .hero-stats {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 22px 0 0;
    border-top: 1px solid var(--line);
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
  }

  .hero-stats strong {
    font-size: 1.7rem;
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-stats span {
    font-size: 0.86rem;
    color: var(--muted);
  }

  .section {
    padding: 36px 20px;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 18px;
  }

  .section-head h2 {
    margin: 0;
  }

  .more {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .more:hover {
    color: var(--accent);
  }

  .status {
    font-size: 0.9rem;
    margin: 0 0 12px;
  }

  .status[data-state='err'] {
    color: #fbbf24;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 14px;
  }

  .cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .cta h2 {
    margin-bottom: 6px;
  }

  .cta p {
    margin: 0;
  }
</style>
