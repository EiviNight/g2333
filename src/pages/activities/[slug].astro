---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('activities');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={entry.data.title} description={entry.data.summary}>
  <article class="wrap page">
    <a class="back" href="/activities">← 返回活动列表</a>

    <header class="page-head">
      <p class="eyebrow">{fmt(entry.data.date)}</p>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.summary}</p>
      <ul class="meta">
        {entry.data.location && <li>{entry.data.location}</li>}
        {entry.data.tags.map((tag) => <li>{tag}</li>)}
      </ul>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 22px;
  }

  .back:hover {
    color: var(--accent);
  }

  .meta {
    display: flex;
    gap: 10px;
    list-style: none;
    padding: 0;
    margin: 18px 0 0;
    flex-wrap: wrap;
  }

  .meta li {
    font-size: 0.78rem;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 2px 11px;
  }

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    margin: 36px 0 12px;
    font-size: 1.25rem;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0 0 16px;
  }

  .prose :global(ul) {
    padding-left: 1.2em;
    margin: 0 0 16px;
  }

  .prose :global(li) {
    margin-bottom: 6px;
  }

  .prose :global(li)::marker {
    color: var(--accent);
  }

  .prose :global(a) {
    color: var(--accent);
  }

  .prose :global(code) {
    background: var(--bg-soft);
    border: 1px solid var(--line);
    border-radius: 5px;
    padding: 1px 6px;
    font-size: 0.88em;
  }

  .prose :global(strong) {
    color: #fff;
  }

  .prose :global(blockquote) {
    margin: 0 0 16px;
    padding-left: 16px;
    border-left: 3px solid var(--line);
    color: var(--muted);
  }
</style>
